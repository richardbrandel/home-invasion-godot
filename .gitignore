# Godot's import cache — regenerated on open, never commit it.
.godot/
# Build outputs. These ship as GitHub Releases assets, not in the repo:
# the .exe is 284 MB and GitHub hard-rejects any file over 100 MB.
build/
*.exe
*.pck
*.app/

# Mixamo assets. Their terms permit commercial use IN A GAME but forbid
# redistributing the raw files — and thief/idle.fbx alone is 106 MB, over
# GitHub's 100 MB file limit, so it could not be pushed regardless.
assets/mixamo/

# Agent instructions for this project. Kept LOCAL and never committed: this
# repository is public, and the file names the first outside playtester.
AGENTS.md

# Verification screenshots are scratch files. The handful the README links to
# are already tracked, so this only stops new ones being added by accident.
shot_*.png
shot_*.png.import

# Transient editor state
*.tmp
*.translation
