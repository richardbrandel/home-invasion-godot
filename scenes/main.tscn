[gd_scene load_steps=2 format=3]

; Deliberately minimal: the world, actors, HUD and camera are all built in code
; by scripts/game.gd. A hand-authored .tscn of a few hundred nodes would be
; unreadable in a diff and impossible to keep in sync with Sim's layout data,
; which stays the single source of truth for where things are.

[ext_resource type="Script" path="res://scripts/game.gd" id="1_game"]

[node name="Main" type="Node3D"]
script = ExtResource("1_game")
